{
  "name": "hubie-live",
  "version": "0.2.0",
  "private": true,
  "description": "Hubie Live — Housebets Contest Labs streamer agent (Node-only pipeline)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
