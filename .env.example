# Housebets contest / integration keys (names only, no values)
HOUSEBETS_API_URL=
HOUSEBETS_API_KEY=
HOUSEBETS_CONTEST_ID=
# Demo-mode game feed (no login); must egress from a non-blocked country
HOUSEBETS_GAMES_URL=https://www.housebets.com/casino

# Brain / LLM — any OpenAI-compatible endpoint (CommandCode by default)
LLM_BASE_URL=https://api.commandcode.ai/provider/v1/chat/completions
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_API_KEY=

# Jev (typesafe/jev) — cheap choice model called over HTTP before the LLM.
# Reuses LLM_API_KEY (or COMMAND_CODE_API_KEY); set JEV_API_KEY only to override.
# No command-code binary and no TYPESAFE_API_KEY are required.
JEV_ENABLED=1
JEV_URL=https://api.commandcode.ai/provider/v1/systemone
JEV_MODEL=typesafe/jev
JEV_CONFIDENCE=0.72
JEV_API_KEY=

# Voice / TTS — TTS_ENGINE=xai|edge|kokoro|piper
# xai: Atlas over wss://api.x.ai/v1/tts (query voice=, not voice_id). Requires XAI_API_KEY.
#      Failover is Edge en-US-AndrewNeural. Do not commit the key.
# edge: no-key rollback. Uses TTS_EDGE_VOICE below (piper behind it). No XAI_API_KEY.
# kokoro: local ONNX sidecar, the default when TTS_ENGINE is unset. Piper is its fallback.
# Install the Kokoro sidecar + models: docs/kokoro-tts.md
TTS_ENGINE=kokoro

# xAI Atlas (only when TTS_ENGINE=xai). Leave the key empty here; set it in the host env.
# XAI_API_KEY=
XAI_VOICE=atlas
XAI_LANGUAGE=en
# WebSocket query: codec=pcm, sample_rate=24000, speed=1.08, optimize_streaming_latency=1.
# with_timestamps stays off (it adds a latency pass). Mouth sync uses playback RMS.
XAI_SAMPLE_RATE=24000
XAI_SPEED=1.08
XAI_LATENCY=1
# Per-line deadline. A first-audio stall cancels xAI once, then speaks the line on Edge.
XAI_TIMEOUT_MS=8000
# Edge voice used only as the xAI failover. TTS_ENGINE=edge still uses TTS_EDGE_VOICE.
XAI_FAILOVER_VOICE=en-US-AndrewNeural
# Local sidecar endpoint (scripts/kokoro_server.py binds 127.0.0.1 only)
KOKORO_URL=http://127.0.0.1:7860
KOKORO_PORT=7860
# LIVE pins am_fenrir. Leave KOKORO_VOICE unset to auto-pick from the sidecar's /voices;
# setting it explicitly always wins (no auto-upgrade).
# KOKORO_VOICE=am_fenrir
# Second voice mixed into the default voice by the sidecar (client still sends am_fenrir).
# Unset = am_michael; KOKORO_BLEND_VOICE= (empty) or off disables the blend.
KOKORO_BLEND_VOICE=am_michael
# Weight of the PRIMARY (am_fenrir) voice in the blend, 0..1; 0.62 = fenrir-heavy.
KOKORO_BLEND_WEIGHT=0.62
# 0.92–0.95 reads slightly slower and less robotic than 1.0.
KOKORO_SPEED=0.94
# Breath spliced between sentence chunks (120–180 ms is the human range).
KOKORO_SENTENCE_PAUSE_MS=150
# Per-line synthesis deadline before falling back to piper
KOKORO_TIMEOUT_MS=12000

# Edge (optional, default OFF): free Microsoft neural, no key. Set TTS_ENGINE=edge.
TTS_EDGE_VOICE=en-US-GuyNeural
# Optional prosody: rate/pitch/volume as Edge expects them (e.g. +10%, -20Hz)
TTS_EDGE_RATE=+0%
TTS_EDGE_PITCH=+0Hz
TTS_EDGE_VOLUME=+0%
# Per-line synthesis deadline before falling back to piper
TTS_EDGE_TIMEOUT_MS=8000

# Piper fallback (also used when TTS_ENGINE=piper); no key needed.
# high = same voice, 114 MB model, ~2x synthesis cost, clearly cleaner
# default medium: RTF 0.19 under load; high sounds marginally better but RTF ~0.94
TTS_VOICE=en_US-lessac-medium
# multi-speaker models only (libritts has 904: swap 0-903; 704 = male, 109 Hz, calm pace)
TTS_SPEAKER=
# Human-feel piper knobs: 1.18 = slower, clearer delivery; 0.45/0.55 = tighter variation
# (less warble); 0.32 s = a longer breath between sentences. Lower length_scale for a brisker read.
TTS_LENGTH_SCALE=1.12
TTS_NOISE_SCALE=0.45
TTS_NOISE_W=0.55
TTS_SENTENCE_SILENCE=0.32
TTS_API_KEY=

# Streaming — Kick: copy the ingest URL + stream key from the channel dashboard
# Twitch equivalent: RTMP_URL=rtmp://live.twitch.tv/app
STREAM_HOST=kick
STREAM_KEY=
RTMP_URL=
VIDEO_BITRATE=3500k

# Channels (chat read; TWITCH_OAUTH only needed to send messages)
# Chat: CHAT_HOST=kick reads kick.com/<channel>/chat with the browser; twitch uses IRC
CHAT_HOST=kick
TWITCH_CHANNEL=
TWITCH_OAUTH=
KICK_CHANNEL=
CHAT_BOT_TOKEN=

# Game capture browser (auto-detected Chrome/Edge when empty)
CHROME_PATH=
# Desktop capture requires headed Chrome (never 0 when CAPTURE_MODE=desktop)
HUBIE_HEADED=1
# Capture source: screencast (CDP frames, default) or desktop (Windows RDP, ffmpeg gdigrab)
# MODE is accepted as an alias when CAPTURE_MODE is unset
CAPTURE_MODE=screencast

# Screen perception. 1 (default) reads the live page into a state object the brain
# uses for idle lines and for which Originals game to open at the rotate.
# 0 keeps the scripted Bet-0 loop. DOM poll interval in ms (minimum 1000).
# Vision fallback never runs faster than 20s, and only when the DOM read is thin.
GAME_PERCEPTION=1
GAME_PERCEPTION_MS=5000
GAME_PERCEPTION_VISION_MS=20000

# Chat brain: knowledge base is data/kb.json, viewer memory data/viewers.json
# SIM_CHAT=1 injects test viewers so the loop can be exercised without a live chat
SIM_CHAT=
# DEBUG_PROMPT=1 logs the grounding block and raw LLM reply for each turn
DEBUG_PROMPT=

# Speech chain applied on the encode (override to taste; empty string disables)
AUDIO_FILTER=

# Recording
RECORD_DIR=
